<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keep framework logs on STDERR at WARN so the CLI's result (the itemDelta XML) is the ONLY thing on
  STDOUT and stays pipeable. Raise to DEBUG here (or via a -D override) when diagnosing prism/schema.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
