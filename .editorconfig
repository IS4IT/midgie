root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
max_line_length = 120

[*.{yml,yaml,json,tpl}]
indent_size = 2

# One logical line per paragraph or bullet: Markdown here is not hard-wrapped.
[*.md]
max_line_length = off
trim_trailing_whitespace = false
