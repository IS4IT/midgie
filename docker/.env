# midPoint server image version (evolveum/midpoint tag).
# MUST match <midpoint.version> in pom.xml — midpoint-diff bundles that version's
# compile-time base schema, so the test server has to be the same major line.
MP_VER=4.10.3

# PostgreSQL major version (the -alpine variant is used).
PG_VER=17

# Host port the midPoint GUI/REST is published on (container is always 8080).
# Kept off 8080 and off the connector-sap rig's 11080 so this rig can coexist.
MP_PORT=12080
