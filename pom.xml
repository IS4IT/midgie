<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.is4it.midpoint</groupId>
    <artifactId>midgie</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>midgie</name>
    <description>Schema-aware diff of midPoint objects into an itemDelta (ObjectModificationType).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Base-schema version knob. The midpoint-schema jar carries the COMPILE-TIME base
             object model (UserType, RoleType, ...), so this MUST match the target midPoint's
             major line. Bump it (and rebuild) to target a different midPoint version. -->
        <midpoint.version>4.10.3</midpoint.version>

        <picocli.version>4.7.6</picocli.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <repositories>
        <!-- midPoint + prism artifacts are published here, not to Maven Central. -->
        <repository>
            <id>evolveum-releases</id>
            <url>https://nexus.evolveum.com/nexus/repository/releases/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Pulls prism-api / prism-impl transitively. Provides MidPointPrismContextFactory,
             DeltaConvertor, and the compile-time base schema on the classpath. -->
        <dependency>
            <groupId>com.evolveum.midpoint.infra</groupId>
            <artifactId>schema</artifactId>
            <version>${midpoint.version}</version>
        </dependency>

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>midgie</finalName>

        <!-- Filter build-info.properties only, so ${midpoint.version} is embedded for the runtime
             version check; everything else (e.g. logback.xml, which contains its own ${} tokens)
             is copied verbatim. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>build-info.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>build-info.properties</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <!-- Pin the properties-file filtering encoding (silences the resources-plugin warning
                 introduced by filtering build-info.properties). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <propertiesEncoding>UTF-8</propertiesEncoding>
                </configuration>
            </plugin>

            <!-- Fat JAR. NOTE: prism/JAXB ship XSD catalogs + ServiceLoader files under
                 META-INF; if the shaded jar misbehaves at runtime, add the matching
                 AppendingTransformer entries (see CLAUDE.md "shade caveat"). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>de.is4it.midpoint.diff.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Without these, colliding NOTICE/LICENSE resources are last-one-wins and
                                     the fat jar ships one of each, dropping the Apache-2.0 NOTICE files it
                                     is required to redistribute (Apache-2.0 section 4(d)). -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <!-- No generated header: it would assert an Apache copyright over
                                         midgie, which is EUPL-1.2. Only the third-party notices belong. -->
                                    <addHeader>false</addHeader>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Blank out the ambient connection environment. ConnectionOptions honours these, so a
                         developer or CI runner that exports them turned the offline CLI tests into live
                         reads against whatever server happened to be configured: 20 tests failed, and the
                         "offline" deploy tests made real network calls. A blank value reads as unset. -->
                    <environmentVariables>
                        <MIDPOINT_URL/>
                        <MIDPOINT_USER/>
                        <MIDPOINT_PASSWORD/>
                        <!-- Keep rollback plans out of the developer's home directory. Every deploy that
                             writes leaves one, and the trees these tests deploy are temp directories with
                             no git identity, so they landed in ~/.local/state/midgie and accumulated
                             there. Redirecting the base is enough: RollbackPlan.defaultBase honours
                             XDG_STATE_HOME, so no test has to remember to pass the flag itself. -->
                        <XDG_STATE_HOME>${project.build.directory}/state</XDG_STATE_HOME>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <!-- docker/.env stays the single source of truth for the rig's port. Hard-coding it
                             here too meant that changing MP_PORT made reachable() fail, all 13 live tests
                             skip, and `mvn verify` stay green with the whole REST surface untested while
                             the rig was up and healthy. -->
                        <midgie.it.url>http://localhost:${MP_PORT}/midpoint</midgie.it.url>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Fail the build if docker/.env's MP_VER drifts from <midpoint.version>. The compile-time
                 schema jar and the rig's server image must share a major line (see docker/README.md). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>check-midpoint-version-sync</id>
                        <phase>validate</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <loadproperties srcFile="docker/.env"/>
                                <!-- Ant properties are write-once, so this only applies when .env omits it. -->
                                <property name="MP_PORT" value="12080"/>
                                <fail message="midPoint version drift: docker/.env MP_VER=${MP_VER} != pom midpoint.version=${midpoint.version}. Bump both together.">
                                    <condition>
                                        <not><equals arg1="${MP_VER}" arg2="${midpoint.version}"/></not>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
