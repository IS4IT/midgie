#!/usr/bin/env sh
# Copyright (c) 2026 IS4IT
#
# SPDX-License-Identifier: EUPL-1.2
#
# Launcher for midgie: locate the fat JAR and run it, adding
# --sun-misc-unsafe-memory-access=allow on JDK 23+ to silence the JEP 498
# warnings that classgraph (a transitive prism dependency) triggers when it
# unmaps memory-mapped schema jars during prism bootstrap. Those warnings are
# written to the native stderr, so they cannot be filtered from inside the JVM
# — the flag is the only suppression. It is unknown to JDK 21 and 22 (which do
# not emit the warning), so it is added only when the running JVM needs it.
# A JVM older than 21 is refused here with a message saying so, rather than
# left to fail on the JAR's class files.
set -eu

# Resolve this script's own directory so the JAR is found regardless of the cwd.
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

# Locate the JAR: explicit override, then a dev build, then a lib/ layout, then alongside the script.
JAR="${MIDGIE_JAR:-}"
if [ -z "$JAR" ]; then
    for candidate in \
        "$SCRIPT_DIR/../target/midgie.jar" \
        "$SCRIPT_DIR/../lib/midgie.jar" \
        "$SCRIPT_DIR/midgie.jar"; do
        if [ -f "$candidate" ]; then
            JAR=$candidate
            break
        fi
    done
fi
if [ -z "$JAR" ] || [ ! -f "$JAR" ]; then
    echo "midgie: cannot find midgie.jar (run 'mvn -q package', or set MIDGIE_JAR)." >&2
    exit 2
fi

# Pick the JVM (respect JAVA_HOME) and read its major version.
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA=java
fi
version=$("$JAVA" -version 2>&1 | awk -F\" '/version/ { print $2; exit }')
major=${version%%.*}
major=${major%%-*}   # an early-access JDK reports "24-ea"; the qualifier is not part of the major
case $major in
    '' | *[!0-9]*) major=0 ;;
esac
# An unreadable version (0) is left to the JVM itself; a known older one gets a plain answer instead of
# an UnsupportedClassVersionError naming class file versions.
if [ "$major" -gt 0 ] && [ "$major" -lt 21 ]; then
    echo "midgie: needs Java 21 or later, but $JAVA is Java $major. Set JAVA_HOME to a JDK 21+." >&2
    exit 2
fi

# JDK 23+ warns on sun.misc.Unsafe memory access; opt out so stderr stays clean. JAVA_OPTS is
# intentionally word-split so callers can pass extra JVM options.
# shellcheck disable=SC2086
if [ "$major" -ge 23 ]; then
    exec "$JAVA" ${JAVA_OPTS:-} --sun-misc-unsafe-memory-access=allow -jar "$JAR" "$@"
fi
# shellcheck disable=SC2086
exec "$JAVA" ${JAVA_OPTS:-} -jar "$JAR" "$@"
